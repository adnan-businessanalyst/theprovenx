# Public site URL used for canonical links, sitemap, Open Graph
# Local:
NEXT_PUBLIC_SITE_URL=http://localhost:21400
# Vercel production example:
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Express API (rewrites /api/* → this origin)
# Local:
API_URL=http://localhost:8080
# Production: your deployed API origin (not Vercel unless you host API elsewhere)
# API_URL=https://your-api.example.com

# Dev server port (also set in package.json scripts)
PORT=21400
